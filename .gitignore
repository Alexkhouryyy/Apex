__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Secrets — never commit. .env.example is the only env file allowed.
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# Local data
*.db

# Claude Code local config (settings, worktrees)
# Ignore .claude contents (worktrees, local settings) but keep the directory
# itself un-excluded so reusable skills below can be re-included and versioned.
.claude/*
!.claude/skills/
