# Windows batch files must reach Windows with CRLF line endings. cmd.exe
# misreads labels (and so `goto`) in LF-only batch files, and a ZIP download
# or a clone without autocrlf would otherwise hand it exactly that.
*.bat text eol=crlf
*.cmd text eol=crlf
*.bat.example text eol=crlf

# Preserve pinned upstream Git blob bytes on Windows.
integrations/gods-eye-view/** -text -whitespace
# Preserve the exact released REA instructions on Windows checkouts.
.agents/skills/reverse-engineer-anything/** text eol=lf
scripts/setup_rea_cloud.sh text eol=lf
